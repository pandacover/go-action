# Optional: canonical origin used when minting shareable URLs
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Optional: HMAC secret for self-contained /g?d= links.
# Defaults to a local-dev value if unset. Set this in production so links
# cannot be forged against your deployment. Changing it invalidates old
# self-contained links.
# GO_ACTION_SIGNING_SECRET=change-me

# Optional: enable short /g/[id] links for long articles
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  # preferred on the server (bypasses RLS)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  # used if service role is absent; requires the RLS policies in supabase/migrations
